# Leave TELEGRAM_API_ID=0 and TELEGRAM_API_HASH=fill_later to use public read-only mode.
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=fill_later
TELEGRAM_SESSION_NAME=lead_funnel
TELEGRAM_CHANNELS=@freelance_dev_work

# Mobile order inbox on the existing VPS. The app account is tied to Nikita's phone.
LEAD_HUB_URL=http://31.129.97.211
LEAD_HUB_API_KEY=dev-local-key
LEAD_HUB_OWNER_PHONE=79679812438
LEAD_HUB_EXECUTOR_ID=kwork-desktop

# Legacy DeepSeek settings. They are no longer required for order analysis or replies.
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_MODEL=deepseek-chat

# OpenRouter evaluates orders and writes customer replies. The fallback model is
# used automatically when a primary model is unavailable or rate-limited.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_ANALYSIS_MODEL=openai/gpt-5.1
OPENROUTER_REPLY_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_FALLBACK_MODELS=openai/gpt-4.1
# Vision enriches screenshots and weak OCR for scanned files in smart mode.
OPENROUTER_VISION_MODEL=qwen/qwen3.7-plus
OPENROUTER_VISION_MODE=smart

DATABASE_PATH=data/leads.sqlite3
SCAN_INTERVAL_SECONDS=60
MAX_POSTS_PER_CHANNEL=30
KWORK_MAX_RESPONSES=6
KWORK_MAX_AGE_HOURS=24
KWORK_COOKIE=
KWORK_SOURCE=web
KWORK_PROJECTS_URL=https://kwork.ru/projects?c=11
KWORK_USE_BROWSER=1
KWORK_CDP_URL=http://127.0.0.1:9222
KWORK_BROWSER_PROFILE_DIR=
KWORK_AUTO_CHROME_COOKIES=1
KWORK_LOGIN_EMAIL=
KWORK_LOGIN_PASSWORD=
KWORK_AUTO_SEND=0
KWORK_AUTO_SEND_DAILY_LIMIT=10
LEAD_MIN_SCORE=60
LEAD_MAX_DAYS=7
LEAD_ACCEPT_DECISIONS=accept,maybe
LEAD_BLOCKED_KEYWORDS=битрикс, bitrix, tilda, тильда, elementor, элементор, приложение ios, ios приложение, swift, xcode
# Optional extra static stop-words. Keep empty to let AI evaluate other stacks.
LEAD_HARD_REJECT_KEYWORDS=
LEAD_REQUIRED_KEYWORDS=
TESSERACT_CMD=D:\Tesseract-OCR\tesseract.exe
# Optional archive tool paths. Leave blank to use automatic discovery.
UNRAR_EXE=
SEVEN_ZIP_EXE=
